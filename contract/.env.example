# ======================================
# SMART CONTRACT DEPLOYMENT ENVIRONMENT
# ======================================
# Location: contract/.env
# Used for: Deploying Scoremint contract to Base mainnet

# Deployer wallet private key (needs ETH for deployment gas)
PRIVATE_KEY=0xyour_deployer_private_key_here

# Base mainnet RPC URL
BASE_RPC_URL=https://mainnet.base.org

# OR use Alchemy/Infura for better reliability:
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Basescan API key (for contract verification)
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Oracle address (wallet that will settle matches - from frontend)
# You can add this after creating the oracle wallet
ORACLE_ADDRESS=0xyour_oracle_wallet_address_here

# Deployer address (your wallet address for reference)
DEPLOYER_ADDRESS=0xyour_deployer_address_here
